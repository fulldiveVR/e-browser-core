<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="be">
<translation id="1026101648481255140">Узнавіць усталяванне</translation>
<translation id="7099479769133613710">Перазапусціць, каб абнавіць &amp;Chrome OS</translation>
<translation id="7061050486072297552">AIWIZE лепш працуе з формамі, таму іх аўтаматычнае запаўненне можна выканаць хутчэй. Гэта налада выключана.</translation>
<translation id="2479110114759182442">AIWIZE рэкамендуе праверыць гэта пашырэнне</translation>
<translation id="3814674848168165531">Калі сайт па спасылках на ім запытвае перадзагрузку старонак у прыватным рэжыме, AIWIZE выкарыстоўвае серверы AIWIZE. Дзякуючы гэтаму перадзагружаны сайт не атрымлівае звестак пра вашу асобу, але AIWIZE атрымлівае даныя пра тое, якія сайты перадзагружаюцца.</translation>
<translation id="5749154344207139683">Прайдзіце апытанне, каб дапамагчы нам палепшыць рэжым інкогніта. Гэта зойме адну хвіліну.</translation>
<translation id="1065672644894730302">Не ўдалося прачытаць вашы параметры.

Некаторыя функцыі могуць быць недаступныя, і змены ў параметрах не захаваюцца.</translation>
<translation id="7577672138294294152">Вашы бацькі выключылі "Дазволы для сайтаў, праграм і пашырэнняў" для AIWIZE</translation>
<translation id="5918095577778020936">AIWIZE запытвае дазвол на экспартаванне вашых пароляў. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="112640046208448578">Вызначайце аб’екты ці месцы і капіруйце ці перакладайце тэкст. Калі вы выкарыстоўваеце пошук відарысаў, здымак старонкі на экране адпраўляецца на сервер. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">AIWIZE з’яўляецца стандартным браўзерам</translation>
<translation id="8522292744959221145">Каб праверыць, ці не пагражае вашым паролям раскрыццё ў выніку ўцечкі даных або іншых праблем з бяспекай, <ph name="BEGIN_LINK"/>увайдзіце ў AIWIZE<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">Націсніце меню AIWIZE</translation>
<translation id="1157985233335035034">Нядаўна выкарыстаныя мовы</translation>
<translation id="1184145431117212167">Не ўдалося выканаць усталяванне, бо гэта версія Windows не падтрымліваецца.</translation>
<translation id="8541922081612557424">Пра AIWIZE</translation>
<translation id="1203500561924088507">Дзякуй, што ўсталявалі <ph name="BUNDLE_NAME"/>. Каб завяршыць усталяванне, перазапусціце браўзер.</translation>
<translation id="8799570501820813406">Гэта ўкладка была неактыўнай, і памяць была вызвалена, каб забяспечыць хуткую работу AIWIZE. Вы можаце дадаць гэты сайт да выключэнняў, каб ён ніколі не адзначаўся як неактыўны.</translation>
<translation id="8767381092474532098">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты файл небяспечны</translation>
<translation id="3256289531845594061">Калі вы ўваходзіце ў сэрвісы AIWIZE (напрыклад, Gmail ці YouTube) праз уліковы запіс <ph name="USER_EMAIL"/>, то можаце аўтаматычна ўвайсці ў AIWIZE пад тым жа ўліковым запісам</translation>
<translation id="1290883685122687410">Памылка наладжвання: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">Наладзьце свой профіль AIWIZE</translation>
<translation id="878572309106296578">Браўзеру AIWIZE неабходны доступ да Bluetooth для пошуку прылад з Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Выявіць мову</translation>
<translation id="108284536240904209">Выдаліць таксама даныя з AIWIZE (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Замацавана! Цяпер пошук відарысаў можна запускаць з дапамогай новай кнопкі панэлі інструментаў.</translation>
<translation id="1356661055722410047">Навінка! Вы можаце перакладаць тэкст і відарысы на экране</translation>
<translation id="1383876407941801731">Пошук</translation>
<translation id="8132634101975074716">Вы ўвайшлі ў AIWIZE!</translation>
<translation id="141901961143729572">Што вы думаеце</translation>
<translation id="3880714039086599943">Каб абагуліць акно, у сістэмных наладах дазвольце браўзеру AIWIZE запіс экрана.</translation>
<translation id="1586284627848250203">Атрымаць даведку па AIWIZE for Testing</translation>
<translation id="1497802159252041924">Памылка ўсталявання: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Гэта старонка абаронена</translation>
<translation id="5147525139567260139">Абагульце ўкладку AIWIZE</translation>
<translation id="1547469039832541117">Завяршае вылучаную задачу.</translation>
<translation id="1530633922026945685">AIWIZE запытвае дазвол на доступ да камеры, каб стварыць 3D-карту асяроддзя</translation>
<translation id="9125033103884432">{NUM_EXTENSIONS,plural, =1{Гэта пашырэнне больш не падтрымліваецца. AIWIZE рэкамендуе выдаліць яго.}one{Гэтыя пашырэнні больш не падтрымліваюцца. AIWIZE рэкамендуе выдаліць іх.}few{Гэтыя пашырэнні больш не падтрымліваюцца. AIWIZE рэкамендуе выдаліць іх.}many{Гэтыя пашырэнні больш не падтрымліваюцца. AIWIZE рэкамендуе выдаліць іх.}other{Гэтыя пашырэнні больш не падтрымліваюцца. AIWIZE рэкамендуе выдаліць іх.}}</translation>
<translation id="51545890371361355">Замацаваць AIWIZE</translation>
<translation id="6570689355868013775">Інструменты бяспекі браўзера AIWIZE</translation>
<translation id="1902837727299679178">AIWIZE збіраецца выдаліць вашы даныя з Менеджара пароляў. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="552349673358711446">{COUNT,plural, =0{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення}=1{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення. Акно ў рэжыме інкогніта не будзе адкрыта паўторна.}one{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення. # акно ў рэжыме інкогніта не будзе адкрыта паўторна.}few{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення. # акны ў рэжыме інкогніта не будуць адкрыты паўторна.}many{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення. # вокнаў у рэжыме інкогніта не будуць адкрыты паўторна.}other{Ваш адміністратар патрабуе перазапусціць AIWIZE для ўсталявання абнаўлення. # акна ў рэжыме інкогніта не будуць адкрыты паўторна.}}</translation>
<translation id="4449148723378534338">Праверка ключавых налад бяспекі і прыватнасці ў AIWIZE</translation>
<translation id="1640672724030957280">Ідзе спампоўванне…</translation>
<translation id="1680687534629375545">Спытаць пра гэту старонку з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="1709772298389099340">Дае пашыраныя правы для браўзера <ph name="BROWSER_NAME"/>.</translation>
<translation id="2913217021115517297">Каб мы маглі палепшыць гэтыя функцыі, AIWIZE адпраўляе ў AIWIZE даныя пра вашы ўзаемадзеянні з імі. Спецыялісты могуць чытаць і апрацоўваць гэтыя даныя, а таксама дадаваць да іх анатацыі.</translation>
<translation id="1722488837206509557">Вы зможаце выбіраць з даступных прылад і адлюстроўваць на іх змесціва.</translation>
<translation id="8004287232784878841">Даныя пра работу ў AIWIZE хутка будуць выдалены</translation>
<translation id="4197839351786449392">AIWIZE будзе па магчымасці выкарыстоўваць для навігацыі пратакол HTTPS</translation>
<translation id="7814200940910057384">Даныя AIWIZE выдалены</translation>
<translation id="9048361966237194186">AIWIZE перазапусціцца праз <ph name="REMAINING_TIME"/></translation>
<translation id="5524150602137990006">Калі пратакол HTTPS недаступны, AIWIZE без папярэджання будзе выкарыстоўваць неабароненае падключэнне</translation>
<translation id="6797402139308059782">Дазволіць AIWIZE выконвацца ў фонавым рэжыме</translation>
<translation id="1448049584457347995">У мэтах бяспекі AIWIZE мы выключылі некаторыя пашырэнні, якія не значацца ў спісе <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> і маглі быць дададзены без вашага ведама.</translation>
<translation id="5875673934455379806">Пераўсталяваць AIWIZE</translation>
<translation id="4529028207655448215">AIWIZE спрабуе <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="1838374766361614909">Ачысціць поле пошуку</translation>
<translation id="3541642064306182066">Каб выдаліць даныя пра работу ў браўзеры толькі з гэтай прылады, але захаваць іх ва Уліковым запісе AIWIZE, <ph name="BEGIN_LINK"/>выйдзіце з AIWIZE<ph name="END_LINK"/>.</translation>
<translation id="4559627161887338743">У гэтым раздзеле можна кіраваць Уліковымі запісамі AIWIZE, у якія вы ўвайшлі. Вашы Уліковыя запісы AIWIZE выкарыстоўваюцца ў браўзеры AIWIZE, Краме Play, пошце Gmail і іншых сэрвісах. Калі вы хочаце дадаць уліковы запіс для каго-небудзь яшчэ (напрыклад, для ўдзельніка сямейнай групы), дадайце на прыладу "<ph name="DEVICE_TYPE"/>" новага карыстальніка. <ph name="LINK_BEGIN"/>Даведацца больш<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Скарыстаць пошук відарысаў</translation>
<translation id="6888366668010117849">Сайты могуць захоўваць звесткі пра вашы інтарэсы ў браўзеры AIWIZE. Напрыклад, калі вы заходзіце на сайт, каб купіць красоўкі для ўдзелу ў марафоне, сайт можа вызначыць у якасці вашага інтарэсу марафонскі бег. Пазней, калі вы наведаеце іншы сайт, каб зарэгістравацца для ўдзелу ў спаборніцтвах па бегу, наведаны сайт можа ўлічыць вашы інтарэсы і паказаць вам рэкламу бегавых красовак.</translation>
<translation id="1880677175115548835">Выбраць тэкст</translation>
<translation id="4528406859989804913">Вы ўваходзіце праз уліковы запіс пад кіраваннем, што дае адміністратару кантроль над вашым профілем у браўзеры AIWIZE. Даныя AIWIZE (праграмы, закладкі, гісторыя, паролі і іншыя налады) будуць назаўсёды прывязаны да ўліковага запісу <ph name="USER_NAME"/>. Вы зможаце выдаліць гэтыя даныя праз панэль кіравання Уліковымі запісамі AIWIZE, але іх нельга будзе звязаць з іншым уліковым запісам. Вы можаце стварыць новы профіль, каб захаваць існуючыя даныя AIWIZE асобна. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">AIWIZE зберагае зарад акумулятара, абмяжоўваючы фонавыя працэсы і візуальныя эфекты (напрыклад, плаўную прагортку і частату кадраў відэа). <ph name="BEGIN_LINK"/>Даведацца больш пра рэжым эканоміі энергіі<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Задайце пытанне пра гэту старонку</translation>
<translation id="8643267611122541711">Сэрвіс абнаўлення AIWIZE</translation>
<translation id="1649714546770135458">Выключыўшы гэта, вы зможаце ўваходзіць на сайты AIWIZE, такія як Gmail, не ўваходзячы ў AIWIZE</translation>
<translation id="916979339327923175">Выдаліць даныя гэтай праграмы з AIWIZE</translation>
<translation id="189297655255130768">AIWIZE не адказвае. Перазапусціць яго?</translation>
<translation id="8422047647688939115">Палітыка вашай арганізацыі (<ph name="MANAGER"/>) патрабуе, каб вы ўвайшлі ў AIWIZE</translation>
<translation id="4035053306113201399">Каб прымяніць абнаўленне, трэба перазапусціць Chrome OS.</translation>
<translation id="9048754176089806686">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты тып файлаў спампоўваюць рэдка і ён можа быць небяспечным</translation>
<translation id="1953553007165777902">Ідзе спампоўванне… Застаецца <ph name="MINUTE"/> хв</translation>
<translation id="1775322105159056176">AIWIZE не можа вызначыць або задаць стандартны браўзер</translation>
<translation id="4372901050442507812">Даведацца, чаму AIWIZE блакіруе некаторыя файлы, інфармацыя адкрыецца ў новай укладцы</translation>
<translation id="2703425183860615504">Гэты сэрвіс падтрымлівае праграмнае забеспячэнне AIWIZE у актуальным стане. Калі сэрвіс адключыць ці спыніць, праграмнае забеспячэнне AIWIZE не будзе абнаўляцца. Гэта азначае, што пагрозы для бяспекі, якія могуць узнікнуць, немагчыма будзе ўстараніць і функцыі могуць перастаць працаваць. Гэты сэрвіс сам сябе выдаляе, калі адсутнічае праграмнае забеспячэнне AIWIZE, якое выкарыстоўвае яго.</translation>
<translation id="9220324636239049437">Будзе выдалены 1 элемент з гэтай прылады. Каб потым атрымаць свае даныя, увайдзіце ва ўліковы запіс AIWIZE як <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Збой усталявання. Паўтарыце спробу.</translation>
<translation id="831418749472885028">Каб праверыць, ці не пагражае вашым іншым паролям раскрыццё ў выніку ўцечкі даных або іншых праблем з бяспекай, <ph name="BEGIN_LINK"/>увайдзіце ў AIWIZE<ph name="END_LINK"/>.</translation>
<translation id="5499149312981370855">Выберыце, ці выкарыстоўваць гісторыю AIWIZE для персаналізацыі сэрвісаў AIWIZE</translation>
<translation id="5888420425384578947">Каб атрымліваць наступныя абнаўленні AIWIZE, вам патрэбная версія macOS 12 ці пазнейшая. На гэтым камп'ютары выкарыстоўваецца macOS 11.</translation>
<translation id="2472891440303445472">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты файл з’яўляецца падманным і можа ўнесці нечаканыя змяненні на вашай прыладзе</translation>
<translation id="2726948994393234543">Вашы паролі і іншыя даныя AIWIZE, захаваныя ва Уліковым запісе AIWIZE, будуць выдалены з гэтай прылады. Увайдзіце паўторна, каб яны зноў сталі даступнымі ў AIWIZE.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{Згодна з наладамі, якія задала ваша арганізацыя, даныя пра работу ў браўзеры аўтаматычна выдаляюцца, калі AIWIZE не выкарыстоўваецца на працягу 1 хвіліны. Гэтыя даныя могуць уключаць гісторыю, спампоўкі і звесткі для аўтазапаўнення. Укладкі застануцца адкрытымі.}one{Згодна з наладамі, якія задала ваша арганізацыя, даныя пра работу ў браўзеры аўтаматычна выдаляюцца, калі AIWIZE не выкарыстоўваецца на працягу # хвіліны. Гэтыя даныя могуць уключаць гісторыю, спампоўкі і звесткі для аўтазапаўнення. Укладкі застануцца адкрытымі.}few{Згодна з наладамі, якія задала ваша арганізацыя, даныя пра работу ў браўзеры аўтаматычна выдаляюцца, калі AIWIZE не выкарыстоўваецца на працягу # хвілін. Гэтыя даныя могуць уключаць гісторыю, спампоўкі і звесткі для аўтазапаўнення. Укладкі застануцца адкрытымі.}many{Згодна з наладамі, якія задала ваша арганізацыя, даныя пра работу ў браўзеры аўтаматычна выдаляюцца, калі AIWIZE не выкарыстоўваецца на працягу # хвілін. Гэтыя даныя могуць уключаць гісторыю, спампоўкі і звесткі для аўтазапаўнення. Укладкі застануцца адкрытымі.}other{Згодна з наладамі, якія задала ваша арганізацыя, даныя пра работу ў браўзеры аўтаматычна выдаляюцца, калі AIWIZE не выкарыстоўваецца на працягу # хвіліны. Гэтыя даныя могуць уключаць гісторыю, спампоўкі і звесткі для аўтазапаўнення. Укладкі застануцца адкрытымі.}}</translation>
<translation id="2126108037660393668">Спампаваны файл не прайшоў праверку.</translation>
<translation id="2137162749895930932">Закрыць функцыю "Перакласці тэкст на экране"</translation>
<translation id="5789330946301045610">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты сайт не выкарыстоўвае абароненае падключэнне і файл мог быць зменены</translation>
<translation id="142389341645668510">Наладзіць AIWIZE</translation>
<translation id="2174917724755363426">Усталяванне не завершана. Вы сапраўды хочаце скасаваць яго?</translation>
<translation id="8745514854244955877">AIWIZE – Уваход у сетку – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Не ўдалося праверыць наяўнасць абнаўленняў: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">Выдаліць уліковы запіс з AIWIZE</translation>
<translation id="6677253423995557759">Небяспечны сайт. AIWIZE адклікаў дазвол на апавяшчэнні.</translation>
<translation id="2236949375853147973">Мае дзеянні</translation>
<translation id="457168681575748148">Каб выкарыстоўваць свае адрасы і іншыя даныя на ўсіх сваіх прыладах, увайдзіце ў AIWIZE. Адрас будзе захаваны ва Уліковым запісе AIWIZE пасля ўваходу.</translation>
<translation id="5659384504794665581">Калі камп’ютар выкарыстоўваюць некалькі чалавек, кожны з іх можа наладзіць AIWIZE для сябе і праглядаць старонкі асобна ад іншых.</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{AIWIZE рэкамендуе прыпыніць укладку, якая запавольвае працу браўзера}one{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}few{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}many{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}other{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}}</translation>
<translation id="7810992039564280750">Правярае, ці знаходзяцца URL-адрасы ў спісе небяспечных сайтаў, захаваным у AIWIZE. Пры спробе сайта выкрасці пароль або пры спампоўванні шкоднага файла браўзер AIWIZE можа таксама адпраўляць у Бяспечны прагляд URL-адрасы, уключаючы фрагменты змесціва старонкі.</translation>
<translation id="9095263438435683933">Каб адпраўляць нумары з гэтай прылады на свой тэлефон Android, увайдзіце ў AIWIZE на абедзвюх прыладах.</translation>
<translation id="2359808026110333948">Працягнуць</translation>
<translation id="6485997157403727556">Пашырэнне "<ph name="EXTENSION_NAME"/>" прапануе вам увайсці ў AIWIZE</translation>
<translation id="7017760840808989683">Адключыць для праграм працу AIWIZE у фонавым рэжыме</translation>
<translation id="8491912023989916905">Каб выкарыстоўваць гэта пашырэнне праз уліковы запіс <ph name="USER_EMAIL_ADDRESS"/>, увайдзіце ў AIWIZE.</translation>
<translation id="8418845734693287262">Сінхранізаваць даныя ў сістэме Chrome OS не ўдалося: даныя ўліковага запісу для ўваходу састарэлі.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{Адно або некалькі пашырэнняў AIWIZE мелі доступ да 1 прылады з чалавека-машынным інтэрфейсам}=1{Адно або некалькі пашырэнняў AIWIZE маюць доступ да 1 прылады з чалавека-машынным інтэрфейсам}one{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылады з чалавека-машынным інтэрфейсам}few{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылад з чалавека-машынным інтэрфейсам}many{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылад з чалавека-машынным інтэрфейсам}other{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылады з чалавека-машынным інтэрфейсам}}</translation>
<translation id="1248225940185478633">AIWIZE запытвае дазвол на доступ да камеры і мікрафона для гэтага сайта</translation>
<translation id="2403703063067034158">Памылка запуску: запушчаны іншы экзэмпляр наладжвання. Паўтарыце спробу пазней.</translation>
<translation id="2118275934191847461"><ph name="BEGIN_LINK"/>Інструменты AIWIZE<ph name="END_LINK"/> абараняюць вашы даныя пры рабоце ў інтэрнэце</translation>
<translation id="2451727308784734061">Каб хутка адкрываць Менеджар пароляў, выкарыстоўвайце ярлык. Яго можна перамясціць на панэль запуску праграм або на галоўны экран камп’ютара.</translation>
<translation id="6381750314821942592">Браўзер AIWIZE хутка будзе закрыты</translation>
<translation id="6078442581074612226">У AIWIZE</translation>
<translation id="2485422356828889247">Выдаліць</translation>
<translation id="2513154137948333830">Патрабуецца перазагрузка. <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Выберыце тэкст з дапамогай пошуку відарысаў</translation>
<translation id="70183448213529602">AIWIZE спрабуе замяніць існуючыя паролі. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="7798069806040634998">Для спампоўвання файлаў браўзеру AIWIZE патрабуецца доступ да сховішча</translation>
<translation id="8447483940522230788">Памочнік AIWIZE</translation>
<translation id="2575822587468774919">Паспрабуйце знайсці што-небудзь з дапамогай пошуку відарысаў</translation>
<translation id="3830890663494219270">Каб выкарыстоўваць свае паролі і іншыя даныя на ўсіх сваіх прыладах, увайдзіце ў AIWIZE</translation>
<translation id="6252796827759111076">Працягнуць работу ў AIWIZE</translation>
<translation id="259935314519650377">Не ўдалося кэшаваць спампаваны ўсталёўшчык. Памылка: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Сістэма</translation>
<translation id="7931230852267968641">Ваша арганізацыя можа праглядаць даныя пра работу ў браўзеры (напрыклад, закладкі, гісторыю і паролі) і кіраваць імі. Яна не можа праглядаць даныя пра работу ў браўзеры, якія захоўваюцца ў іншых профілях AIWIZE.</translation>
<translation id="2257221826278123061">Каб выкарыстоўваць і захоўваць даныя AIWIZE ва Уліковым запісе <ph name="ACCOUNT_EMAIL"/>, пацвердзіце сваю асобу</translation>
<translation id="7788346643684168549">Павышаецца хуткасць AIWIZE, і правільна працуюць функцыі, якія выкарыстоўваюць JavaScript (рэкамендуецца)</translation>
<translation id="7387051847644272380">Падчас усталявання адбылася памылка аперацыйнай сістэмы. Спампуйце AIWIZE зноў.</translation>
<translation id="2648689842065142443">Калі прыладу выкарыстоўваюць некалькі чалавек, кожны з іх можа наладзіць AIWIZE для сябе і праглядаць старонкі асобна ад іншых</translation>
<translation id="6791166902140255175">Укладка AIWIZE</translation>
<translation id="8372880274820509128">Для большай бяспекі AIWIZE будзе шыфраваць даныя.</translation>
<translation id="8752006915531191162">Каб выдаліць Уліковы запіс AIWIZE з AIWIZE, выйдзіце з яго</translation>
<translation id="5344406739101555055">Каб выкарыстоўваць свае паролі, закладкі і іншыя даныя на ўсіх сваіх прыладах, увайдзіце ў AIWIZE</translation>
<translation id="2738871930057338499">Не ўдалося падключыцца да інтэрнэту. Памылка HTTP 403: доступ забаронены. Праверце налады проксі-сервера.</translation>
<translation id="2753623023919742414">Націсніце для пошуку</translation>
<translation id="1312769823139326127">Зрабіце AIWIZE стандартным сродкам для прагляду файлаў PDF</translation>
<translation id="2770231113462710648">Зрабіць стандартным наступны браўзер:</translation>
<translation id="1187986649024576560">Пашырэнне ўтрымлівае шкоднае ПЗ і з’яўляецца небяспечным. Выдаліце яго з AIWIZE, каб яно больш не магло бачыць і змяняць даныя на сайтах, якія вы наведваеце, уключаючы вашу асабістую інфармацыю.</translation>
<translation id="2799223571221894425">Перазапусціць</translation>
<translation id="5962774139606909656">Ваш AIWIZE</translation>
<translation id="2816462166102338036">Шукаць гэта відэа з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="2841525013647267359">Перакласці з наступнай мовы:</translation>
<translation id="2846251086934905009">Адбылася памылка. Усталёўшчык не завяршыў працу. Усталяванне перарвана.</translation>
<translation id="777113543093865885">Выдаліць з AIWIZE...</translation>
<translation id="5265419033369521352">Абараняе вас у браўзеры AIWIZE і можа выкарыстоўвацца для паляпшэння бяспекі ў іншых праграмах AIWIZE, калі вы ўвайшлі ва ўліковы запіс</translation>
<translation id="2885378588091291677">Менеджар заданняў</translation>
<translation id="2176825726964012531">Пра &amp;AIWIZE</translation>
<translation id="2915996080311180594">Перазапусціць пазней</translation>
<translation id="2928420929544864228">Усталяванне завершана.</translation>
<translation id="2481553173340651149">Вашы даныя зашыфраваны фразай-паролем. Увядзіце яе, каб захоўваць і выкарыстоўваць даныя AIWIZE ва Уліковым запісе AIWIZE.</translation>
<translation id="2945997411976714835">Адбылася памылка. Не ўдалося пачаць усталяванне.</translation>
<translation id="3688936822855019158">Ваша арганізацыя кіруе браўзерам AIWIZE</translation>
<translation id="8208853227947884571">AIWIZE абноўлены</translation>
<translation id="5122472867956731189">Пры спробе сайта выкрасці пароль або пры спампоўванні шкоднага файла браўзер AIWIZE можа таксама адпраўляць у Бяспечны прагляд URL-адрасы, уключаючы фрагменты змесціва старонкі</translation>
<translation id="3963199983793987097">Каб заставацца ў бяспецы ў інтэрнэце дзякуючы параметрам, якія выбралі твае бацькі, увайдзі ў AIWIZE</translation>
<translation id="3003694935412297923">Усе задачы</translation>
<translation id="4202995875619419215">Адкрыць <ph name="URL"/> у новай укладцы ў AIWIZE.</translation>
<translation id="8755404239607088219">Браўзеру AIWIZE не ўдаецца праверыць паролі. Паўтарыце спробу пазней.</translation>
<translation id="8880183781256147665">Дадаецца ў AIWIZE...</translation>
<translation id="3038232873781883849">Чаканне ўсталявання...</translation>
<translation id="3045032126857188731">Мова перакладу: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Закрыць дыялогавае акно водгуку</translation>
<translation id="4503085212612536713">Іншыя профілі AIWIZE</translation>
<translation id="7918740962659365265">Дапамагаць палепшыць AIWIZE, адпраўляючы ў AIWIZE справаздачы аб збоях і <ph name="UMA_LINK"/></translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{Адно або некалькі пашырэнняў AIWIZE мелі доступ да 1 прылады USB}=1{Адно або некалькі пашырэнняў AIWIZE маюць доступ да 1 прылады USB}one{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылады USB}few{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылад USB}many{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылад USB}other{Адно або некалькі пашырэнняў AIWIZE маюць доступ да # прылады USB}}</translation>
<translation id="5320085753638900910">Гісторыя прагляду сайтаў уплывае на рэкламу, якая вам паказваецца, і на спіс пералічаных ніжэй інтарэсаў. У мэтах аховы вашай прыватнасці звесткі пра вашы інтарэсы ў AIWIZE штомесяц аўтаматычна выдаляюцца. Інтарэсы могуць абнаўляцца, пакуль вы іх не выдаліце.</translation>
<translation id="7365690458036015383">Усталёўшчык не змог распакаваць архіў. Спампуйце AIWIZE зноў.</translation>
<translation id="310459126943037700">Не ўдалося завяршыць задачы.</translation>
<translation id="8919461291440820124">AIWIZE выкарыстоўвае ваш мікрафон.</translation>
<translation id="3137969841538672700">Перацягніце для пошуку</translation>
<translation id="8372436892102763334">Гэта ўкладка выкарыстоўвае дадатковыя рэсурсы. Дазвольце AIWIZE адключыць яе, каб павысіць прадукцыйнасць працы.</translation>
<translation id="5949068186379578553">Каб абагуліць экран, у сістэмных наладах дазвольце браўзеру AIWIZE запіс экрана.</translation>
<translation id="4805806622840861220">Перазапусціць AIWIZE</translation>
<translation id="3161522574479303604">Усе мовы</translation>
<translation id="6554952862405000915">Адкрыць спасылку ў акне інко&amp;гніта ў AIWIZE</translation>
<translation id="1742948938503172561">Наладзьце новы профіль AIWIZE</translation>
<translation id="4805865169608137960">Каб выдаліць свой Уліковы AIWIZE з AIWIZE, выйдзіце з AIWIZE на старонцы налад</translation>
<translation id="1651639704310627074">Пазней AIWIZE можа спытаць, ці хочаце вы выкарыстоўваць захаваную інфармацыю для аўтазапаўнення форм.</translation>
<translation id="2585240446624043880">AIWIZE не можа чытаць з каталога даных і запісваць у яго:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Перазапусціць</translation>
<translation id="2339258256897053758">Адсутнічаюць ключы AIWIZE API. Некаторыя функцыі AIWIZE будуць выключаны.</translation>
<translation id="8926637909431618259">Працягваць выконваць фонавыя праграмы, калі AIWIZE закрыты</translation>
<translation id="518125528057094977">AIWIZE будзе папярэджваць вас, перш чым загружаць сайт праз неабароненае падключэнне</translation>
<translation id="8652321858775514885">Калі вы закрыеце ўсе вокны AIWIZE, то выйдзеце з большасці сайтаў, але застаняцеся ва Уліковым запісе AIWIZE, калі раней выканалі ўваход у AIWIZE. Каб дазволіць сайтам запамінаць вас, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">верхні правы вугал поля пошуку: <ph name="RIGHT"/>% справа, <ph name="TOP"/>% зверху</translation>
<translation id="3369405342922656244">Шукаць гэту старонку з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="2297290224191497273">Пераключыцца на існуючы профіль AIWIZE?</translation>
<translation id="3412460710772753638">У Менеджары пароляў на гэтай прыладзе</translation>
<translation id="9216183508558772570">AIWIZE адправіць вам апавяшчэнне, калі вы ўвойдзеце ва ўліковы запіс, выкарыстаўшы раскрыты пароль</translation>
<translation id="5853262807109651878">З гэтай прылады будзе выдалена наступная колькасць элементаў: <ph name="ITEMS_COUNT"/>. Каб потым атрымаць свае даныя, увайдзіце ў AIWIZE як <ph name="USER_EMAIL"/>.</translation>
<translation id="2024972335338126423">Пераключацца паміж профілямі AIWIZE можна, выкарыстоўваючы спалучэнне клавіш <ph name="SHORTCUT"/></translation>
<translation id="8703492925273919597">Закрыйце ўсе вокны AIWIZE і паўтарыце спробу.</translation>
<translation id="599091950194451698">Каб абагуліць акно, у сістэмных наладах дазвольце браўзеру AIWIZE запіс экрана.</translation>
<translation id="1447863765638888625">Карыстальнік <ph name="EXISTING_USER"/> ужо ўвайшоў.  Каб аддзяліць сваю працу ў інтэрнэце ад працы іншых карыстальнікаў, увайдзіце ў AIWIZE ва ўласны профіль як <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="4061445349373849749">У мэтах аховы вашай прыватнасці старэйшыя за 4 тыдні звесткі пра вашы інтарэсы аўтаматычна выдаляюцца. Па меры прагляду сайтаў у інтэрнэце пэўныя інтарэсы могуць з’яўляцца ў спісе зноў. Вы таксама можаце выдаляць пэўныя інтарэсы, калі не хочаце, каб браўзер AIWIZE іх улічваў.</translation>
<translation id="8981774130895723211">Каб абагуліць экран, у сістэмных наладах дазвольце браўзеру AIWIZE запіс экрана.</translation>
<translation id="691208314680168371">Гісторыя прагляду сайтаў – інфармацыя пра сайты, якія вы наведалі праз AIWIZE на гэтай прыладзе.</translation>
<translation id="3597003331831379823">Не ўдалося запусціць наладжванне з пашыранымі правамі. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="3066805437003400520">Даныя аб прагледжаных гэтым карыстальнікам старонках будуць выдалены з прылады. Каб аднавіць гэтыя даныя, увайдзіце ў AIWIZE як <ph name="USER_EMAIL"/>.</translation>
<translation id="8274659559228306809">{COUNT,plural, =0{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску.}=1{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску. Акно ў рэжыме інкогніта не будзе адкрыта паўторна.}one{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску. # акно ў рэжыме інкогніта не будзе адкрыта паўторна.}few{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску. # акны ў рэжыме інкогніта не будуць адкрыты паўторна.}many{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску. # вокнаў у рэжыме інкогніта не будуць адкрыты паўторна.}other{Даступна новае абнаўленне для AIWIZE. Яно будзе прыменена пасля перазапуску. # акна ў рэжыме інкогніта не будуць адкрыты паўторна.}}</translation>
<translation id="7029305463989165490">Каб адпраўляць нумары з <ph name="ORIGIN"/> на свой тэлефон Android, увайдзіце ў AIWIZE на абедзвюх прыладах.</translation>
<translation id="3667616615096815454">Не ўдалося ўсталяваць, бо сервер не распазнаў гэту праграму.</translation>
<translation id="4304059894777924102">Браўзеру AIWIZE не ўдаецца праверыць паролі. Паспрабуйце праверыць падключэнне да інтэрнэту.</translation>
<translation id="3829358914761176693">{COUNT,plural, =0{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення}=1{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення. Акно ў рэжыме інкогніта не будзе адкрыта паўторна.}one{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення. # акно ў рэжыме інкогніта не будзе адкрыта паўторна.}few{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення. # акны ў рэжыме інкогніта не будуць адкрыты паўторна.}many{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення. # вокнаў у рэжыме інкогніта не будуць адкрыты паўторна.}other{Ваш адміністратар просіць перазапусціць AIWIZE для ўсталявання абнаўлення. # акна ў рэжыме інкогніта не будуць адкрыты паўторна.}}</translation>
<translation id="1807774211756215222">Адкрыць спасылку ў новай &amp;укладцы AIWIZE</translation>
<translation id="387105482057676379">Звяжыце AIWIZE з іншымі сэрвісамі AIWIZE для персаналізацыі і іншых мэт</translation>
<translation id="3867175562099983425">Кіраваць профілямі AIWIZE</translation>
<translation id="308146532933302843">Даведацца, чаму AIWIZE блакіруе некаторыя спампоўкі</translation>
<translation id="2189149060536531804">AIWIZE паведаміць вам, калі нешта будзе патрабаваць вашай увагі</translation>
<translation id="6324134303015966238">AIWIZE перадзагружае старонкі, на якія вы з высокай імавернасцю можаце перайсці, каб яны адкрыліся хутчэй, калі вы іх наведаеце</translation>
<translation id="3810973564298564668">Кіраваць</translation>
<translation id="5381622442243174305"><ph name="PAGE_TITLE"/> – AIWIZE</translation>
<translation id="3885770153807205175">Інструмент выбару мовы</translation>
<translation id="6315734375101223238">Наладка і кіраванне AIWIZE Нешта патрабуе вашай увагі – каб паглядзець падрабязныя звесткі, націсніце тут.</translation>
<translation id="7130675370997202556">Каб адкрыць AIWIZE і пачаць прагляд вэб-старонак, націсніце на сваё імя.</translation>
<translation id="3892148308691398805">Скапіраваць тэкст</translation>
<translation id="4920958997042285125">Уваход у гэты профіль AIWIZE ужо выкананы карыстальнікам <ph name="EXISTING_USER"/>. Каб аддзяліць вашу працу ў інтэрнэце ад працы іншых карыстальнікаў, AIWIZE можа стварыць для вас ваш уласны профіль.</translation>
<translation id="6184592406110188164">Гэта пашырэнне парушае палітыку Вэб-крамы AIWIZE і можа быць небяспечным. Выдаліце яго з AIWIZE, каб яно больш не магло бачыць і змяняць даныя на сайтах, якія вы наведваеце, уключаючы вашу асабістую інфармацыю.</translation>
<translation id="3941890832296813527">Адбылася памылка. Назва файла ўсталёўшчыка несапраўдная ці не падтрымліваецца.</translation>
<translation id="8090497651549769448">AIWIZE спрабуе скапіраваць паролі. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="4256965182800026277">Вашы паролі, спосабы аплаты і адрасы, захаваныя ў вашым Уліковым запісе AIWIZE, будуць выдалены з гэтай прылады. Увайдзіце паўторна, каб яны зноў сталі даступнымі ў AIWIZE.</translation>
<translation id="395904275706073188">Немагчыма прачытаць абароненыя старонкі. Паспрабуйце іншую старонку.</translation>
<translation id="4194619960643453552">Даведайцеся, як AIWIZE абараняе вас</translation>
<translation id="1486377520191913768">Калі вы ўводзіце тэкст у адрасным радку або ў полі пошуку, AIWIZE адпраўляе гэта змесціва ў інструменты пошуку, штучнага інтэлекту і агентаў вашай арганізацыі, каб вы маглі атрымліваць прапановы.</translation>
<translation id="1311808042904310985">Пра &amp;AIWIZE for Testing</translation>
<translation id="1152920704813762236">Пра Chrome OS</translation>
<translation id="3703994572283698466">Chrome OS, як і <ph name="BEGIN_LINK_LINUX_OSS"/>асяроддзе распрацоўкі Linux<ph name="END_LINK_LINUX_OSS"/>, працуе дзякуючы дадатковаму <ph name="BEGIN_LINK_CROS_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="4022972681110646219">Перакласці экран</translation>
<translation id="4023601594785368013">Мова арыгінала: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">Вы можаце адкрываць спасылкі з любой праграмы ў AIWIZE. Для хуткага доступу браўзер замацаваны на панэлі задач.</translation>
<translation id="6056473803837713617">Дапамажыце палепшыць AIWIZE, паведаміўшы <ph name="BEGIN_LINK"/>бягучыя налады<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">У апошняй версіі з’явіліся важныя паляпшэнні сістэмы бяспекі і новыя функцыі.</translation>
<translation id="4055805654398742145">&amp;Менеджар пароляў</translation>
<translation id="6217792792122501564">{COUNT,plural, =1{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу 1 хвіліны. Даныя пра работу ў браўзеры, якія могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення, будуць выдалены.}one{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвіліны. Даныя пра работу ў браўзеры, якія могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення, будуць выдалены.}few{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвілін. Даныя пра работу ў браўзеры, якія могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення, будуць выдалены.}many{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвілін. Даныя пра работу ў браўзеры, якія могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення, будуць выдалены.}other{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвіліны. Даныя пра работу ў браўзеры, якія могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення, будуць выдалены.}}</translation>
<translation id="2589970573128789862">Рэжым інкогніта ў AIWIZE</translation>
<translation id="5794951150713244901">Перайсці на старонку "Пра AIWIZE"</translation>
<translation id="4148957013307229264">Ідзе ўсталяванне...</translation>
<translation id="4658486203392098459"><ph name="PAGE_TITLE"/> – Уваход у сетку – AIWIZE</translation>
<translation id="2871190378186459992">Адкрывайце для сябе выдатныя праграмы, гульні, пашырэнні і тэмы для AIWIZE.</translation>
<translation id="462105622535258178">Каб атрымаць доступ да гэтага пашырэння і іншых функцый на ўсіх камп’ютарах, увайдзіце ў AIWIZE</translation>
<translation id="6670140629169983459">Каб заставацца ў бяспецы ў інтэрнэце дзякуючы параметрам, якія выбралі твае бацькі, пераключыся на свой профіль AIWIZE, дзе ў цябе ўжо выкананы ўваход як <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Адмяняецца...</translation>
<translation id="4224210481850767180">Усталяванне скасавана.</translation>
<translation id="1853997773668795891">Звязаць вашы даныя AIWIZE з гэтым уліковым запісам?</translation>
<translation id="4732930052828648898">Папярэджвае пра небяспечныя сайты (нават тыя, пра якія ў AIWIZE дагэтуль не было звестак), аналізуючы больш даных з сайтаў, чым аналізуецца пры стандартнай абароне. Папярэджанні браўзера AIWIZE можна прапускаць.</translation>
<translation id="2201661640076600072">Выйсці з AIWIZE</translation>
<translation id="3262506503470845422">Атрымаць дапамогу па AIWIZE</translation>
<translation id="4281844954008187215">Умовы выкарыстання</translation>
<translation id="7691786510374174420">Збой усталявання з-за нявызначанай памылкі. Калі AIWIZE зараз запушчаны, закрыйце яго і паўтарыце спробу.</translation>
<translation id="4304713468139749426">Менеджар пароляў</translation>
<translation id="4334241893986177674">Пошук па гэтым здымку экрана</translation>
<translation id="4334294535648607276">Спампоўванне завершана.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> патрабуе ад вас прачытаць і прыняць наступныя Умовы выкарыстання, перш чым пачаць карыстацца прыладай. Гэтыя ўмовы не пашыраюць, не змяняюць і не абмяжоўваюць Умовы выкарыстання Chrome OS.</translation>
<translation id="9183662282810237335">Усё роўна выйсці з AIWIZE?</translation>
<translation id="4413205837991854510">Заўсёды паказваць ярлык для пошуку відарысаў</translation>
<translation id="4065288863231444640">Дазволіць браўзеру AIWIZE працаваць у фоне</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{AIWIZE рэкамендуе выдаліць яго. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/>}one{AIWIZE рэкамендуе выдаліць іх. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/>}few{AIWIZE рэкамендуе выдаліць іх. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/>}many{AIWIZE рэкамендуе выдаліць іх. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/>}other{AIWIZE рэкамендуе выдаліць іх. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">Наладка і кіраванне AIWIZE</translation>
<translation id="4427306783828095590">Функцыя палепшанай абароны яшчэ надзейней блакіруе фішынг і шкодныя праграмы</translation>
<translation id="4434353761996769206">Памылка ўсталёўшчыка. <ph name="INSTALLER_ERROR"/>.</translation>
<translation id="175926951572479413">Арганізацыя "<ph name="MANAGER"/>" кіруе браўзерам AIWIZE</translation>
<translation id="3579012341787637143">Дадаць профіль AIWIZE</translation>
<translation id="6786534271003695094">Пра AIWIZE for Testing</translation>
<translation id="526235294307144732">Каб выкарыстоўваць і захоўваць даныя AIWIZE ва Уліковым запісе AIWIZE, увядзіце фразу-пароль</translation>
<translation id="4493028449971051158">Памылка запуску: запусціце ўсталёўшчык ад імені адміністратара.</translation>
<translation id="4501471624619070934">Не ўдалося ўсталяваць з-за абмежавання доступу ў гэтай краіне.</translation>
<translation id="8594994021633965927">Для гэтага пашырэння не апублікаваны меры забеспячэння прыватнасці, напрыклад звесткі пра тое, як яно збірае і выкарыстоўвае даныя. AIWIZE рэкамендуе выдаліць яго.</translation>
<translation id="7084397798469173252">Вітаем у AIWIZE! Адкрыта новае акно браўзера</translation>
<translation id="137732229629632648">Браўзеру AIWIZE патрабуецца дазвол на стварэнне карты вашага асяроддзя і адсочванне рук.</translation>
<translation id="5917968343741192617">AIWIZE лепш працуе з формамі, таму іх аўтаматычнае запаўненне можна выканаць хутчэй</translation>
<translation id="5036046007335188949">Вы ўжо ўвайшлі ў іншы профіль AIWIZE як <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="1878185978731985193">AIWIZE перадзагружае старонкі, што паскарае работу браўзера і пошук. <ph name="BEGIN_LINK"/>Даведацца больш пра перадзагрузку старонак<ph name="END_LINK"/></translation>
<translation id="4567424176335768812">Вы ўвайшлі як <ph name="USER_EMAIL_ADDRESS"/> і цяпер маеце доступ да закладак, гісторыі і іншых налад на ўсіх прыладах, дзе выкананы ўваход.</translation>
<translation id="8669339108356170796">Браўзер AIWIZE заблакіраваў спампоўку, бо вы выключылі Бяспечны прагляд і гэты файл нельга праверыць</translation>
<translation id="4594305310729380060">У Менеджар пароляў на гэтай прыладзе</translation>
<translation id="300669147395456190">Праграмы AIWIZE</translation>
<translation id="4598116752460667024">Шукаць працэс са спіса.</translation>
<translation id="4970880042055371251">Версія Chrome OS</translation>
<translation id="2182657378556811785">Амаль гатова! Каб завяршыць абнаўленне, перазапусціце AIWIZE.</translation>
<translation id="6311668361877328515">Функцыя паскарае працу з сайтамі дзякуючы апрацоўшчыку AIWIZE V8, але робіць AIWIZE крыху менш устойлівым да атак</translation>
<translation id="7843665350820058984">AIWIZE лепш працуе з формамі, таму іх аўтаматычнае запаўненне можна выканаць хутчэй. Гэта налада ўключана.</translation>
<translation id="1299765473362724475">Увага! AIWIZE не можа забараніць пашырэнням весці запіс гісторыі прагляду сайтаў. Скасуйце выбар гэтай налады, каб адключыць дадзенае пашырэнне ў рэжыме інкогніта.</translation>
<translation id="7402642357351265733">Калі вы абагульваеце справаздачы пра выкарыстанне браўзера AIWIZE, у іх уключаюцца URL-адрасы наведаных вамі старонак</translation>
<translation id="8142245354207161805">Здаецца, профіль выкарыстоўваецца іншым працэсам AIWIZE (<ph name="PROCESS_ID"/>) на іншым камп’ютары (<ph name="HOST_NAME"/>). AIWIZE заблакіраваў профіль, каб яго нельга было пашкодзіць. Калі вы ўпэўненыя, што іншыя працэсы гэты профіль не выкарыстоўваюць, можна разблакіраваць профіль і перазапусціць AIWIZE.</translation>
<translation id="4680828127924988555">Скасаваць усталяванне</translation>
<translation id="2014343159590733363">Некаторыя вашы даныя AIWIZE яшчэ не захаваны ва Уліковым запісе AIWIZE. Пачакайце некалькі хвілін, перш чым выйсці. Калі вы выйдзеце зараз, гэтыя даныя будуць выдалены.</translation>
<translation id="2408746614080689238">Пакуль выкананы ўваход, вы можаце выкарыстоўваць у AIWIZE свае паролі і іншыя даныя Уліковага запісу AIWIZE. Налады сэрвісаў AIWIZE можна змяніць з дапамогай спалучэння клавіш <ph name="SHORTCUT"/>.</translation>
<translation id="847561904663814268">Нехта раней увайшоў у AIWIZE на гэтым камп’ютары як <ph name="ACCOUNT_EMAIL_LAST"/>. Стварыце новага карыстальніка AIWIZE, каб трымаць сваю інфармацыю асобна.</translation>
<translation id="4724676981607797757">Выканаць усталяванне не ўдалося з-за памылкі: пратакол не падтрымліваецца.</translation>
<translation id="3834935463915107022">Усё роўна закрыць AIWIZE?</translation>
<translation id="8668413672647811944">Толькі што было прыменена спецыяльнае абнаўленне бяспекі для AIWIZE. Перазапусціце браўзер, і вашы ўкладкі будуць адноўлены.</translation>
<translation id="4941816441131888792">Вы даўно не наведвалі сайт. Браўзер AIWIZE адклікаў наступныя дазволы: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> і яшчэ <ph name="COUNT"/>.</translation>
<translation id="4823369970559443694">Браўзеру AIWIZE не ўдаецца праверыць паролі. Паўтарыце спробу праз 24 гадзіны або <ph name="BEGIN_LINK"/>праверце паролі ва Уліковым запісе AIWIZE<ph name="END_LINK"/>.</translation>
<translation id="215320507915280336">Гэта функцыя выкарыстоўвае тую ж праверку правапісу, што ў AIWIZE Пошуку. Уведзены ў браўзер тэкст адпраўляецца ў AIWIZE. Гэта можна змяніць у наладах.</translation>
<translation id="2899369907387169108">Выкарыстоўваць AIWIZE без уліковага запісу</translation>
<translation id="1912973375560256099">Уваходнае правіла для AIWIZE, якое дазваляе трафік mDNS.</translation>
<translation id="711601904575862069">Перазапусціць, каб абнавіць &amp;AIWIZE</translation>
<translation id="4918844574251943176">Відарыс скапіраваны</translation>
<translation id="8797356639448065696">AIWIZE працуе ў фонавым рэжыме.</translation>
<translation id="1895567721497166950">Націсніце, каб закрыць дыялогавае акно ўваходу ў AIWIZE</translation>
<translation id="2692971232706994729">Профілі AIWIZE патрэбныя для раздзельнага выкарыстання браўзера рознымі людзьмі і ў розных мэтах. Стварайце профілі для сяброў і родных або раздзяляйце работу і забавы.</translation>
<translation id="7406627712452599344">Госці могуць выкарыстоўваць AIWIZE, не пакідаючы нічога пасля сябе.</translation>
<translation id="5952898964075639679">Дадаць мяне ў AIWIZE</translation>
<translation id="1204184037023366446">AIWIZE запытвае дазвол на адсочванне рухаў рук</translation>
<translation id="5406591571925937375">Вы даўно не наведвалі сайт. Браўзер AIWIZE адклікаў наступныя дазволы: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> і <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Звычайна вы блакіруеце апавяшчэнні. Каб даць дазвол гэтаму сайту на паказ апавяшчэнняў, націсніце значок апавяшчэнняў у правым вугле панэлі месцазнаходжання.</translation>
<translation id="8157129267754368853">Патрабуецца паўторная аўтэнтыфікацыя ўліковага запісу AIWIZE</translation>
<translation id="9078804073692109646">Няма захаваных пароляў. AIWIZE можа правяраць толькі захаваныя паролі.</translation>
<translation id="6234515504547364178">Выйсці з AIWIZE</translation>
<translation id="5234764350956374838">Адхіліць</translation>
<translation id="5254739261293693943">Спытаць пра гэта відэа</translation>
<translation id="8586264863973514035">Каб прымяніць змяненні, перазапусціце AIWIZE</translation>
<translation id="5286907366254680517">Выяўлена</translation>
<translation id="5994282802285556682">Пры праглядзе старонак у рэжыме інкогніта AIWIZE будзе папярэджваць вас, перш чым загружаць сайт праз неабароненае падключэнне</translation>
<translation id="300369155175407115">Калі ўключаны пробныя функцыі, а AIWIZE выпадкова зробіць вас карыстальнікам такой актыўнай функцыі, ваша гісторыя прагляду сайтаў будзе ўплываць на тое, якая рэклама будзе вам паказвацца, і на ацэнку вашых інтарэсаў, пералічаных у спісе ніжэй. У мэтах аховы вашай прыватнасці звесткі пра вашы інтарэсы ў AIWIZE штомесяц рэгулярна выдаляюцца.</translation>
<translation id="6944930779012811739">Унутраны сэрвіс абнаўлення AIWIZE</translation>
<translation id="7573068992266397941">У нас ёсць некалькі рэкамендацый па бяспецы пры рабоце ў AIWIZE</translation>
<translation id="8174413867995118050">Іншыя профілі AIWIZE</translation>
<translation id="7708394612738038097">Вы ўваходзіце праз уліковы запіс пад кіраваннем, што дае адміністратару кантроль над вашым профілем у браўзеры AIWIZE. Даныя AIWIZE (праграмы, закладкі, гісторыя, паролі і іншыя налады) будуць назаўсёды прывязаны да ўліковага запісу <ph name="USER_NAME"/>. Вы зможаце выдаліць гэтыя даныя праз панэль кіравання Уліковымі запісамі AIWIZE, але іх нельга будзе звязаць з іншым уліковым запісам. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Дадатковы код: <ph name="EXTRA_CODE"/>.</translation>
<translation id="2487133103111559902">Каб наладзіць персаналізацыю, уключыце AIWIZE у гісторыю дзеянняў у інтэрнэце і праграмах</translation>
<translation id="5154625106151193600">Даведацца, чаму AIWIZE блакіруе некаторыя файлы</translation>
<translation id="1786715389543715322">AIWIZE абнаўляецца (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="7021823858304886493">Дазволіць уваход у AIWIZE</translation>
<translation id="5267531627648004734">Выдаліць з AIWIZE</translation>
<translation id="4620757336635063467">Зніжае прадукцыйнасць, але павышае ўстойлівасць AIWIZE супраць атак</translation>
<translation id="239760341987199724">Зрабіць AIWIZE стандартным браўзерам</translation>
<translation id="1403270718080126244"><ph name="PAGE_TITLE"/> – AIWIZE (бэта-версія)</translation>
<translation id="604223321106006231">{NUM_TABS,plural, =1{AIWIZE рэкамендуе прыпыніць укладку, якая запавольвае працу браўзера}one{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}few{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}many{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}other{AIWIZE рэкамендуе прыпыніць укладкі, якія запавольваюць працу браўзера}}</translation>
<translation id="894936507076470937">AIWIZE на гэтым дыстрыбутыве Linux больш не падтрымліваецца і таму можа працаваць няправільна</translation>
<translation id="2596557398669145729">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты файл можа нанесці шкоду вашым асабістым уліковым запісам і ўліковым запісам у сацыяльных сетках</translation>
<translation id="696826782632239602">AIWIZE патрабуецца доступ да геаданых, каб абагуліць звесткі аб вашым месцазнаходжанні з гэтым сайтам</translation>
<translation id="3809116188788099368">У мэтах аховы вашай прыватнасці старэйшыя за 4 тыдні звесткі пра вашы інтарэсы аўтаматычна выдаляюцца. Па меры прагляду сайтаў у інтэрнэце пэўныя інтарэсы могуць з’яўляцца ў спісе зноў. Калі AIWIZE няправільна ацаніў вашы інтарэсы або вы не хочаце бачыць пэўную рэкламу, вы можаце выдаліць пэўны інтарэс.</translation>
<translation id="1744365871163268756">Пачакайце, пакуль AIWIZE усталюе апошнія абнаўленні сістэмы.</translation>
<translation id="3861679447659630159">AIWIZE спрабуе змяніць паролі. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="5524890928877629608">верхні левы вугал поля пошуку: <ph name="LEFT"/>% злева, <ph name="TOP"/>% зверху</translation>
<translation id="232381795826373334">Адкрываць PDF-файлы ў AIWIZE</translation>
<translation id="5579324208890605088">Памылка запуску: запусціце ўсталёўшчык ад імені звычайнага карыстальніка, а не адміністратара.</translation>
<translation id="3588973534877826647">Зрабіце AIWIZE стандартным браўзерам і замацуйце яго на панэлі задач</translation>
<translation id="5596627076506792578">Дадатковыя параметры</translation>
<translation id="5605834417512968703">Паспрабуйце знайсці што-небудзь з дапамогай пошуку відарысаў або націсніце Esc, каб закрыць яго</translation>
<translation id="5618818588972826921">Выберыце тэкст або відарыс для пошуку з дапамогай пошуку відарысаў або націсніце Escape, каб закрыць пошук відарысаў</translation>
<translation id="1026406809507858026">{0,plural, =0{Ёсць абнаўленне AIWIZE}=1{Ёсць абнаўленне AIWIZE}one{Абнаўленне AIWIZE выйшла # дзень таму}few{Абнаўленне AIWIZE выйшла # дні таму}many{Абнаўленне AIWIZE выйшла # дзён таму}other{Абнаўленне AIWIZE выйшла # дня таму}}</translation>
<translation id="1023472437588692618">Заўсёды выдаляць даныя сайтаў з прылады пры закрыцці AIWIZE</translation>
<translation id="5646769069113654257">Перазапусціце AIWIZE</translation>
<translation id="3117204675033805491">AIWIZE LLC</translation>
<translation id="2335583906071111058">Паказваць інтэрфейс браўзера AIWIZE на гэтай мове</translation>
<translation id="569897634095159764">Не ўдалося падключыцца да інтэрнэту. Проксі-сервер патрабуе прайсці аўтэнтыфікацыю.</translation>
<translation id="1834213228893578875">AIWIZE ачышчае аператыўную памяць, выдзеленую для неактыўных укладак. Гэта дазваляе вызваляць рэсурсы камп’ютара для актыўных укладак і іншых праграм і падтрымліваць хуткасць работы AIWIZE. Неактыўныя ўкладкі аўтаматычна зноў становяцца актыўнымі, калі вы на іх вяртаецеся. <ph name="BEGIN_LINK"/>Даведацца больш пра рэжым эканоміі памяці<ph name="END_LINK"/></translation>
<translation id="899523323751802352">Калі вы забылі фразу-пароль або хочаце змяніць гэту наладу, <ph name="SETTINGS_LINK"/> даныя AIWIZE ва ўліковым запісе</translation>
<translation id="82926023981336111">Наладжвайце AIWIZE і кіруйце ім. Зрабіце AIWIZE стандартным браўзерам.</translation>
<translation id="5809516625706423866">Не ўдалося падключыцца да інтэрнэту. Памылка HTTP 401: патрабуецца аўтарызацыя. Праверце налады проксі-сервера.</translation>
<translation id="95980832839683236">Функцыя паскарае працу сайтаў на рухавіку AIWIZE V8, але робіць AIWIZE крыху менш устойлівым да атак. Гэта налада выключана.</translation>
<translation id="1224606669200461217">Абнавіце AIWIZE, каб захоўваць і выкарыстоўваць даныя AIWIZE ва Уліковым запісе AIWIZE</translation>
<translation id="5824893331272123205">Не ўдалося загрузіць гэту панэль. Паўтарыце спробу.</translation>
<translation id="7207456302801184289">Вас вітае AIWIZE</translation>
<translation id="5871205389137001634">Націсніце, каб выйсці з пошуку відарысаў</translation>
<translation id="8054200348483755053">Браўзер AIWIZE выявіў, што наступныя элементы змяшчаюць шкоднае ПЗ:</translation>
<translation id="3955583201925082436">AIWIZE пастаянна сочыць за тым, каб у вашым браўзеры былі самыя бяспечныя налады. Мы паведамім вам, калі нешта будзе патрабаваць вашай увагі.</translation>
<translation id="5895138241574237353">Перазапусціць</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> – Уваход у сетку</translation>
<translation id="5924017743176219022">Ідзе падключэнне да інтэрнэту...</translation>
<translation id="5941711191222866238">Згарнуць</translation>
<translation id="5768962901674164501">Каб выкарыстоўваць гэту закладку і іншыя даныя на ўсіх сваіх прыладах, увайдзіце ў AIWIZE</translation>
<translation id="5968400720580217226">Рэжым AI</translation>
<translation id="3613110494561632737">Калі AIWIZE выпадкова зробіць вас карыстальнікам актыўнай пробнай функцыі, ваша гісторыя прагляду сайтаў будзе ўплываць на тое, якая рэклама будзе вам паказвацца, і на ацэнку вашых інтарэсаў, пералічаных у спісе ніжэй. У мэтах аховы вашай прыватнасці звесткі пра вашы інтарэсы ў AIWIZE штомесяц рэгулярна выдаляюцца. Інтарэсы будуць абнаўляцца, пакуль вы іх не выдаліце.</translation>
<translation id="4357808717322635817">{COUNT,plural, =1{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу 1 хвіліны.}one{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвіліны.}few{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвілін.}many{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвілін.}other{Ваша арганізацыя задала налады, згодна з якімі браўзер AIWIZE аўтаматычна закрываецца, калі дзеянні ў ім не выконваюцца на працягу # хвіліны.}}</translation>
<translation id="3598551856834560515">Абнавіце AIWIZE, каб пачаць сінхранізацыю</translation>
<translation id="5225261774087485064">Гэта звычайная практыка, калі сайты, якія вы наведваеце, запамінаюць, што іменна вас цікавіць, каб персаналізаваць для вас сваё змесціва. Сайты таксама могуць захоўваць звесткі пра вашы інтарэсы ў браўзеры AIWIZE.</translation>
<translation id="6003112304606738118">Ідзе спампоўванне… Застаецца <ph name="HOURS"/> гадз</translation>
<translation id="6009821354356307391">Задайце дадатковае пытанне</translation>
<translation id="6040143037577758943">Закрыць</translation>
<translation id="700488072601322385">Каб абараніць свае даныя, дазвольце AIWIZE адклікаць дазволы ў сайтаў, якія вы не наведвалі ў апошні час. Апавяшчэнні пры гэтым не адключаюцца.</translation>
<translation id="9071554113102421877">&amp;Адкрыць у AIWIZE</translation>
<translation id="6069027071882229820">Скапіраваць як відарыс</translation>
<translation id="7861579472672677409">Пашырэнне <ph name="EXTENSION_NAME"/> дададзена да AIWIZE</translation>
<translation id="3693188491491843187">Паскорце работу AIWIZE</translation>
<translation id="5849446944780602366">Наладжвайце AIWIZE і кіруйце ім. Ёсць абнаўленне.</translation>
<translation id="5711722515923392428">Укл. • AIWIZE не можа праверыць паходжанне гэтага пашырэння</translation>
<translation id="7433698744896946664">Дазволіць пашырэнню паказваць запыты на доступ на панэлі інструментаў AIWIZE</translation>
<translation id="4168372721886011198">Файл <ph name="FILE_NAME"/> небяспечны, таму AIWIZE заблакіраваў яго.</translation>
<translation id="991182453936521413">Браўзер AIWIZE хутка будзе закрыты, а даныя пра работу ў ім – выдалены</translation>
<translation id="4060970194201477024">Пераключацца паміж профілямі AIWIZE можна тут</translation>
<translation id="7815000350132166985">Калі вы дазволіце прымяняць файлы cookie, AIWIZE зможа выкарыстоўваць іх падчас перадзагрузкі</translation>
<translation id="6165508094623778733">Даведацца больш</translation>
<translation id="5739368447874065758">Выдаліць даныя AIWIZE ва ўліковым запісе</translation>
<translation id="6685697979743742605">Гэты файл можа быць небяспечным<ph name="LINE_BREAK"/>AIWIZE можа праверыць спампоўку, калі вы ўведзяце пароль. Інфармацыя пра файл перадаецца ў AIWIZE Бяспечны прагляд, але змесціва файла і пароль застаюцца на прыладзе.</translation>
<translation id="6182736845697986886">Выканаць усталяванне не ўдалося з-за ўнутранай памылкі сервера абнаўленняў.</translation>
<translation id="4368341489795135329">Упэўніцеся, што вы ўвайшлі ў AIWIZE на прыладзе "<ph name="TARGET_DEVICE_NAME"/>", а затым паспрабуйце ажыццявіць адпраўку яшчэ раз.</translation>
<translation id="8320964054148936490">На гэтым камп’ютары ўжо ўсталявана навейшая версія AIWIZE. Калі праграма не працуе, выдаліце AIWIZE і паўтарыце спробу.</translation>
<translation id="3574823187131579180">{0,plural, =0{Перазапуск AIWIZE адбудзецца зараз}=1{AIWIZE будзе перазапушчаны праз 1 секунду}one{AIWIZE будзе перазапушчаны праз # секунду}few{AIWIZE будзе перазапушчаны праз # секунды}many{AIWIZE будзе перазапушчаны праз # секунд}other{AIWIZE будзе перазапушчаны праз # секунды}}</translation>
<translation id="6239161312595354541">Спытаць пра гэта відэа з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="5980269616827212166">Для спампоўвання файлаў браўзеру AIWIZE патрабуецца дазвол на доступ да сховішча</translation>
<translation id="7651600795135059130">Правярае, ці знаходзяцца URL-адрасы ў спісе небяспечных сайтаў, захаваным у AIWIZE</translation>
<translation id="5019879183386042809">Зрабіць AIWIZE стандартным браўзерам</translation>
<translation id="7445061995866044926">Выйсці з уліковага запісу ў браўзеры AIWIZE?</translation>
<translation id="4659866260728515512">Гэтыя ўкладкі выкарыстоўваюць дадатковыя рэсурсы. Дазвольце AIWIZE адключыць іх, каб павысіць прадукцыйнасць працы.</translation>
<translation id="6806912298071949921">Наладзьце свой профіль AIWIZE</translation>
<translation id="3792238845239580301">Дайце назву свайму профілю AIWIZE</translation>
<translation id="5874208157501051620">Пашырэнне прапануе вам увайсці ў AIWIZE</translation>
<translation id="3561569806301739367">Файл "<ph name="FILE_NAME"/>" можа быць небяспечным, таму AIWIZE заблакіраваў яго.</translation>
<translation id="3205074487970075628">AIWIZE выкарыстоўвае камеру.</translation>
<translation id="6327105987658262776">Няма даступных абнаўленняў.</translation>
<translation id="1819119299840995223">У AIWIZE выконваецца іншая аперацыя. Паўтарыце спробу пазней.</translation>
<translation id="8616874628011103667">Цяпер выкарыстоўваць AIWIZE з Уліковым запісам AIWIZE стала прасцей і на агульнадаступных камп’ютарах.</translation>
<translation id="4264606872840545968">Ярлык для AIWIZE</translation>
<translation id="6890616081898535725">Браўзер AIWIZE заблакіраваў спампоўку, бо гэты файл спампоўваюць рэдка і ён можа быць небяспечным</translation>
<translation id="335632367599648646">Сапраўды выдаліць AIWIZE?</translation>
<translation id="6375219077595103062">Як дадаць ярлык на Менеджар пароляў</translation>
<translation id="6388799252195623474">дапамагчы мне з гэтым</translation>
<translation id="7920857181125123335">Каб працягнуць, увайдзіце ў AIWIZE як <ph name="EMAIL"/>. Калі вы зробіце гэта, пры выкарыстанні сэрвісу для вас будуць дзейнічаць палітыкі арганізацыі.</translation>
<translation id="3256100650978957522">Лагатып AIWIZE на экране камп’ютара.</translation>
<translation id="6373767849825830651">AIWIZE – гэта вэб-браўзер, які апрацоўвае вэб-старонкі і запускае праграмы з неймавернай хуткасцю: хуткі, стабільны і просты ў выкарыстанні. Павышаная бяспека прагляду вэб-старонак забяспечваецца ўбудаванай у AIWIZE аховай ад шкодных праграм і фішынгу.</translation>
<translation id="6436260184216827876">Пошук відарысаў недаступны. Паўтарыце спробу пазней.</translation>
<translation id="2139300032719313227">Перазапусціце Chrome OS</translation>
<translation id="638302211119176182">AIWIZE перадзагружае яшчэ больш старонак, на якія вы з высокай імавернасцю можаце перайсці, каб яны адкрыліся хутчэй, калі вы іх наведаеце</translation>
<translation id="890319829408077946">Выкл. • AIWIZE не можа праверыць паходжанне гэтага пашырэння</translation>
<translation id="1684121725014454063">Вітаем у профілях AIWIZE</translation>
<translation id="7906693299331092358">Выдаліць уліковы запіс з AIWIZE</translation>
<translation id="2675662665675552980">Таксама вызначае, якая старонка паказваецца пра запуску AIWIZE.</translation>
<translation id="648319183876919572">Палепшаны Бяспечны прагляд забяспечвае дадатковую абарону ад небяспечных вэб-сайтаў і спамповак</translation>
<translation id="5590013613412457132">Выдаліць AIWIZE</translation>
<translation id="7185585387858242335">Ярлыкі адкрываюцца ў AIWIZE</translation>
<translation id="5324409579559361527">Пакуль выкананы ўваход, вы можаце выкарыстоўваць у AIWIZE свае паролі і іншыя даныя Уліковага запісу AIWIZE. Гэты параметр заўсёды можна змяніць у наладах.</translation>
<translation id="3617744907966785605">Ваша арганізацыя закрывае AIWIZE, калі ім не карысталіся на працягу <ph name="TIMEOUT_DURATION"/>. Даныя пра работу ў браўзеры выдалены. Даныя могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення.</translation>
<translation id="8646609321956191980">У кожным профілі захоўваюцца свае даныя AIWIZE, напрыклад закладкі, гісторыя, паролі і не толькі</translation>
<translation id="6756656512757374876">Даведайцеся больш пра тое, <ph name="BEGIN_LINK"/>як AIWIZE забяспечвае прыватнасць вашых даных<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">Змяненне гэтай налады будзе прыменена пасля перазапуску AIWIZE.</translation>
<translation id="2535436634051789953">Вы можаце пераключыцца на прагляд пароляў з іншага профілю AIWIZE</translation>
<translation id="2312399718665761438">Для выпраўлення арфаграфічных памылак AIWIZE адпраўляе ў AIWIZE тэкст, які вы набіраеце ў тэкставых палях</translation>
<translation id="3507835409099344374">Перайсці ў налады апавяшчэнняў AIWIZE</translation>
<translation id="6600016381025017075">Шукайце на гэтай старонцы любое змесціва</translation>
<translation id="9156965752763025780">Змены ўступяць у сілу пасля перазапуску AIWIZE.</translation>
<translation id="245693535809364497">Каб стварыць 3D-карту наваколля, AIWIZE запытвае дазвол на доступ да камеры</translation>
<translation id="9210457680074341078">Калі вы захаваеце закладкі таксама ў сваім Уліковым запісе AIWIZE, вы зможаце сачыць за цэнамі на тавары ў AIWIZE і атрымліваць апавяшчэнні аб іх зніжэнні</translation>
<translation id="6676384891291319759">Доступ у інтэрнэт</translation>
<translation id="1363996462118479832">Сістэме Chrome OS не ўдалося сінхранізаваць даныя з-за памылкі ўваходу.</translation>
<translation id="5324448127277983819">AIWIZE забяспечвае дадатковы кантроль над тым, якую рэкламу вы бачыце, і абмяжоўвае колькасць даных, якія сайты могуць атрымліваць пра вас пры паказе персаналізаванай рэкламы</translation>
<translation id="1257247502847251159">AIWIZE запытвае дазвол на доступ да мікрафона для гэтага сайта</translation>
<translation id="6712881677154121168">Памылка спампоўкі: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="1489465648257900784">Ваш профіль нельга выкарыстоўваць, бо ён з навейшай версіі AIWIZE.

Некаторыя функцыі могуць быць недаступныя. Укажыце іншы каталог профілю або выкарыстайце навейшую версію AIWIZE.</translation>
<translation id="1505112054322049777">Каб наладзіць персаналізацыю і іншыя функцыі, уключыце AIWIZE у гісторыю дзеянняў у інтэрнэце і праграмах і звязаныя сэрвісы AIWIZE</translation>
<translation id="6666624454809779082">AIWIZE ужо ўсталяваны для ўсіх карыстальнікаў на камп’ютары.</translation>
<translation id="4020203987234748583">Функцыя паскарае працу сайтаў на рухавіку AIWIZE V8, але робіць AIWIZE крыху менш устойлівым да атак. Гэта налада ўключана.</translation>
<translation id="3136039682492230890">AIWIZE рэкамендуе праверыць гэты файл, бо ён можа быць небяспечным.</translation>
<translation id="1547295885616600893">Chrome OS працуе дзякуючы дадатковаму <ph name="BEGIN_LINK_CROS_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Перакласці</translation>
<translation id="8211837073776713955">AIWIZE апавяшчае вас у выпадку ўзлому вашых пароляў</translation>
<translation id="684888714667046800">Не ўдалося падключыцца да інтэрнэту. Калі вы выкарыстоўваеце брандмаўар, упэўніцеся, што <ph name="PRODUCT_EXE_NAME"/> знаходзіцца ў белым спісе.</translation>
<translation id="7830723774663008396">AIWIZE – <ph name="PAGE_TITLE"/></translation>
<translation id="6862030660799253820">Шукаць гэты відарыс з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="3028928628792374067">Браўзер AIWIZE выявіў, што пашырэнне "<ph name="EXTENSION_NAME"/>" змяшчае шкоднае ПЗ</translation>
<translation id="6877155553248388166">ніжні правы вугал поля пошуку: <ph name="RIGHT"/>% справа, <ph name="BOTTOM"/>% знізу</translation>
<translation id="6896758677409633944">Капіраваць</translation>
<translation id="862687584320433626">Усталюйце AIWIZE у якасці стандартнага браўзера і замацуйце яго на панэлі задач</translation>
<translation id="126871877963043118">Калі ўключаны пробныя функцыі, тэхналогія вымярэння паказчыкаў, звязаных з рэкламай, дазваляе сайтам, якія вы наведваеце, запытваць інфармацыю ў AIWIZE, каб выкарыстоўваць яе для ацэнкі эфектыўнасці сваёй рэкламы. Яна таксама абмяжоўвае механізмы адсочвання паводзін на розных сайтах, перадаючы паміж імі мінімальны аб’ём інфармацыі.</translation>
<translation id="6934579572334859869">Спытаць пра гэты відарыс з дапамогай функцыі "Пошук відарысаў"</translation>
<translation id="4392161457256085190">Пасля гэтага сайты, якія вы наведваеце, могуць запытваць у браўзера AIWIZE інфармацыю пра вашы інтарэсы, каб персаналізаваць для вас рэкламу. AIWIZE можа абагуліць не больш за 3 інтарэсы.</translation>
<translation id="4624945300945265642">Адкрыць спасылку ў акне інко&amp;гніта ў AIWIZE</translation>
<translation id="6965382102122355670">ОК</translation>
<translation id="6418340404893954563">Ненадзейныя паролі лёгка адгадаць. Дазвольце AIWIZE <ph name="BEGIN_LINK"/>ствараць для вас надзейныя паролі і запамінаць іх<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">Умовы Chrome OS</translation>
<translation id="3335606533094650083">AIWIZE запытвае дазвол на доступ да мікрафона для гэтага сайта</translation>
<translation id="6643520655691573653">Каб выкарыстоўваць і захоўваць даныя AIWIZE ва ўліковым запісе <ph name="ACCOUNT_EMAIL"/>, увядзіце фразу-пароль</translation>
<translation id="7011190694940573312">Усталяваць праграму не ўдалося, бо гэта версія аперацыйнай сістэмы не падтрымліваецца.</translation>
<translation id="7024536598735240744">Памылка распакоўкі: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">Усталяванне спынена.</translation>
<translation id="280382502853897110">Дастасуйце AIWIZE да сваіх мэт</translation>
<translation id="1705567146636171298">Абнавіць AIWIZE</translation>
<translation id="5499063270485366718">Калі відарыс не мае прыдатнага апісання, AIWIZE паспрабуе дадаць яго для вас. Каб стварыць апісанні, відарысы адпраўляюцца ў AIWIZE.</translation>
<translation id="5966368554860795750">Наладзіць AIWIZE for Testing</translation>
<translation id="375314543563594498">Выдаліць <ph name="EXTENSION_NAME"/> з AIWIZE</translation>
<translation id="2332301637111071062">Ваша арганізацыя выдаляе даныя AIWIZE, калі імі не карысталіся на працягу <ph name="TIMEOUT_DURATION"/>. Даныя могуць уключаць у сябе гісторыю, спампоўкі і звесткі для аўтазапаўнення.</translation>
<translation id="1008530050039597147">AIWIZE запытвае дазвол на доступ да камеры для гэтага сайта</translation>
<translation id="1197672524850678392">Не атрымалася запусціць AIWIZE. Паўтарыце спробу.</translation>
<translation id="3405035915691517126">Браўзеру AIWIZE не ўдаецца праверыць паролі. Паўтарыце спробу праз 24 гадзіны.</translation>
<translation id="5755581833598928580">Выкарыстоўвайце AIWIZE кожны раз, калі націскаеце на спасылкі ў паведамленнях, дакументах або іншых праграмах</translation>
<translation id="5516268345616100622">Менеджар заданняў – AIWIZE</translation>
<translation id="713191641919118540">Вашы інтарэсы паводле ацэнкі браўзера AIWIZE</translation>
<translation id="7274695763216404502">Замацавана! Цяпер пошук відарысаў можна запускаць з панэлі інструментаў.</translation>
<translation id="7288567540154601580">Укладкі і пашырэнні</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{AIWIZE рэкамендуе выдаліць яго}one{AIWIZE рэкамендуе выдаліць іх}few{AIWIZE рэкамендуе выдаліць іх}many{AIWIZE рэкамендуе выдаліць іх}other{AIWIZE рэкамендуе выдаліць іх}}</translation>
<translation id="9068395155143628872">Тэхналогія вымярэння паказчыкаў, звязаных з рэкламай, дазваляе сайтам, якія вы наведваеце, запытваць інфармацыю ў AIWIZE, каб выкарыстоўваць яе для ацэнкі эфектыўнасці сваёй рэкламы. Яна таксама абмяжоўвае механізмы адсочвання паводзін на розных сайтах, перадаючы паміж імі мінімальны аб’ём інфармацыі.</translation>
<translation id="1864557848095568223">Ідзе абнаўленне AIWIZE</translation>
<translation id="3403365884036456766">Файл параметраў пашкоджаны або няправільны.

Не ўдалося аднавіць налады ў браўзеры AIWIZE.</translation>
<translation id="7339898014177206373">Новае акно</translation>
<translation id="3511996232906761537">Тут знаходзяцца вашы вэб-старонкі, закладкі і іншыя даныя браўзера AIWIZE.</translation>
<translation id="5380963249588143069">Ваш сістэмны адміністратар наладзіў AIWIZE так, каб для доступу да <ph name="TARGET_URL_HOSTNAME"/> адкрываўся браўзер <ph name="ALTERNATIVE_BROWSER_NAME"/>.</translation>
<translation id="7352651011704765696">Нешта пайшло не так</translation>
<translation id="2865744782251083875">Вы даўно не наведвалі сайт. Браўзер AIWIZE адклікаў наступныя дазволы: <ph name="PERMISSION_1"/> і <ph name="PERMISSION_2"/>.</translation>
<translation id="4631170166710903214">Пашырэнне больш не падтрымліваецца. AIWIZE рэкамендуе выдаліць яго.</translation>
<translation id="3943696263619956191"><ph name="PAGE_TITLE"/> – AIWIZE Dev</translation>
<translation id="7450541714075000668">Тэкст скапіраваны</translation>
<translation id="2034072705932785495">AIWIZE запытвае дазвол на доступ да вашай камеры для гэтага сайта</translation>
<translation id="7129342855140808694">Каб выкарыстоўваць мікрафон, дайце AIWIZE адпаведны доступ у <ph name="BEGIN_LINK"/>сістэмных наладах<ph name="END_LINK"/></translation>
<translation id="5296583608321648908">Каб атрымліваць наступныя абнаўленні AIWIZE, вам патрэбная версія Windows 10 ці пазнейшая. На гэтым камп’ютары выкарыстоўваецца Windows 7.</translation>
<translation id="3962395975456095331">Перазапусціць AIWIZE?</translation>
<translation id="2619516027171717873">Немагчыма ўсталяваць тую ж версію AIWIZE, што зараз працуе. Закрыйце AIWIZE і паўтарыце спробу.</translation>
<translation id="2731639583336131792">Вы зможаце захоўваць і выкарыстоўваць паролі і іншыя даныя ў сваім Уліковым запісе AIWIZE пасля ўваходу ў AIWIZE. <ph name="LEARN_MORE"/></translation>
<translation id="5337027666828618338">Верагодна, сайты будуць працаваць правільна. Калі вы закрыеце ўсе вокны AIWIZE, вы выйдзеце з большасці сайтаў, але застаняцеся ва Уліковым запісе AIWIZE, калі раней выканалі ўваход у AIWIZE.</translation>
<translation id="3186363903915641692">{0,plural, =1{AIWIZE будзе перазапушчаны праз 1 хвіліну}one{AIWIZE будзе перазапушчаны праз # хвіліну}few{AIWIZE будзе перазапушчаны праз # хвіліны}many{AIWIZE будзе перазапушчаны праз # хвілін}other{AIWIZE будзе перазапушчаны праз # хвіліны}}</translation>
<translation id="552342471964912391">Каб абараніць свае даныя, дазвольце AIWIZE адклікаць дазволы ў сайтаў, якія вы не наведвалі ў апошні час.</translation>
<translation id="6378857626787254617">AIWIZE можа ацэньваць, якія вы маеце інтарэсы. Пасля гэтага сайты, якія вы наведваеце, могуць запытваць у браўзера AIWIZE інфармацыю пра вашы інтарэсы, каб персаналізаваць для вас рэкламу.</translation>
<translation id="7583399374488819119">Усталёўшчык <ph name="COMPANY_NAME"/></translation>
<translation id="3293668930608086049">AIWIZE выкарыстоўвае камеру і мікрафон.</translation>
<translation id="2827121003398607864">AIWIZE стаў яшчэ лепшым</translation>
<translation id="3071313329776323836">Цяпер для вас даступна больш функцый у AIWIZE</translation>
<translation id="7649070708921625228">Даведка</translation>
<translation id="7658239707568436148">Скасаваць</translation>
<translation id="3343095737966473035">AIWIZE не з’яўляецца стандартным браўзерам</translation>
<translation id="5477319665405831211">Сінхранізуйце і персаналізуйце AIWIZE на сваіх прыладах</translation>
<translation id="2339273275658335597">абнаўленне AIWIZE</translation>
<translation id="7716950018788545737">Задачы завершаны.</translation>
<translation id="77283119132245232">Забяспечвае работу сэрвісаў трасіроўкі сістэмы для браўзера <ph name="BROWSER_NAME"/>. Калі гэты сэрвіс адключаны, трасіроўкі прадукцыйнасці, створаныя браўзерам, не будуць утрымліваць сістэмныя падзеі, у прыватнасці пераключэнне кантэксту і гатовыя падзеі ў ланцужку.</translation>
<translation id="4784414698887946907">Гэта дзеянне выдаліць з прылады даныя прагляду старонак у інтэрнэце. Каб потым атрымаць свае даныя, увайдзіце ва ўліковы запіс AIWIZE як <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Усталёўшчыку не ўдалося стварыць часовы каталог. Праверце, ці ёсць вольнае месца на дыску і дазвол на ўсталяванне праграмнага забеспячэння.</translation>
<translation id="1978509466033734608">Паскорце працу AIWIZE</translation>
<translation id="6236814935154483927"><ph name="PAGE_TITLE"/> – AIWIZE Canary</translation>
<translation id="2684504034454188774">Зрабіце так, каб тыя, у каго ёсць доступ да вашага інтэрнэт-трафіка, не маглі ўбачыць, якія сайты вы наведваеце. AIWIZE выкарыстоўвае абароненае падключэнне для пошуку IP-адраса ў сістэме даменных імёнаў (DNS).</translation>
<translation id="7810005234485217901">Для зручнага доступу можна замацаваць пошук відарысаў</translation>
<translation id="1652855885539187849">Профіль AIWIZE з такім уліковым запісам ужо існуе на гэтай прыладзе</translation>
<translation id="7845233973568007926">Дзякуй, што ўсталявалі <ph name="BUNDLE_NAME"/>. Каб завяршыць усталяванне, перазапусціце камп’ютар.</translation>
<translation id="79269250264141507">Пры ўводзе тэксту ў адрасны радок або ў поле пошуку AIWIZE будзе адпраўляць яго ў стандартную пошукавую сістэму, каб падабраць для вас найлепшыя прапановы пошуку. У рэжыме інкогніта гэта функцыя не працуе.</translation>
<translation id="7963515534397191222">Браўзеру AIWIZE не ўдалося абнавіцца да апошняй версіі, таму ў ім няма новых функцый і выпраўленняў сістэмы бяспекі.</translation>
<translation id="7872446069773932638">Ідзе спампоўванне… Застаецца <ph name="SECONDS"/> с</translation>
<translation id="7877212753140190672">Спытаць пра гэты відарыс</translation>
<translation id="5687542525349822727">Зрабіць AIWIZE стандартным браўзерам</translation>
<translation id="6396151137840491551">Калі магчыма, AIWIZE аўтаматычна пераходзіць з неабароненага падключэння на HTTPS</translation>
<translation id="2925193881330501265">Вы ўваходзілі ва ўліковы запіс AIWIZE як <ph name="USER_EMAIL_ADDRESS"/>. Для паўторнага ўваходу выкарыстоўвайце той жа самы ўліковы запіс.</translation>
<translation id="6915252145142862992">Гэта другасны ўсталяваны экзэмпляр AIWIZE – яго нельга зрабіць стандартным браўзерам.</translation>
<translation id="1743665722170667430">Пашырэнні, праграмы і тэмы з невядомых крыніц могуць прычыніць шкоду вашай прыладзе. AIWIZE рэкамендуе ўсталёўваць іх толькі з наступнай крыніцы: <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>.</translation>
<translation id="8004582292198964060">Браўзер</translation>
<translation id="8010081455002666927">Аўтавызначэнне</translation>
<translation id="7685904775439037072">Як толькі AIWIZE атрымае дазвол, вэб-сайты змогуць запытваць у вас доступ.</translation>
<translation id="3230755314472063687">Замацуйце AIWIZE на панэлі задач для хуткага доступу да праграмы</translation>
<translation id="80471789339884597">Дзякуй, што ўсталявалі <ph name="BUNDLE_NAME"/>. Каб завяршыць усталяванне, перазапусціце ўсе свае браўзеры.</translation>
<translation id="8054112667659782652">Заўсёды паказваць ярлык для пошуку відарысаў</translation>
<translation id="6175141682081019059">Адключыць для праграм працу AIWIZE у фонавым рэжыме</translation>
<translation id="80790299200510644">Пошук відарысаў</translation>
<translation id="8086881907087796310">Усталяваць праграму не ўдалося, бо апаратнае забеспячэнне камп’ютара не адпавядае неабходным мінімальным патрабаванням.</translation>
<translation id="8263061319795838019"><ph name="PAGE_TITLE"/> – AIWIZE for Testing</translation>
<translation id="2061155704815580583">AIWIZE запытвае дазвол на вызначэнне месцазнаходжання для гэтага сайта</translation>
<translation id="8118331347066725040">Адправіць водгук на пошук з дапамогай Аб’ектыва</translation>
<translation id="5334309298019785904">Сістэме Chrome OS не ўдалося сінхранізаваць вашы даныя: для вашага дамена сінхранізацыя недаступная.</translation>
<translation id="813913629614996137">Ідзе ініцыялізацыя...</translation>
<translation id="9067428552314418522">Файл небяспечны, таму AIWIZE заблакіраваў яго.</translation>
<translation id="8177472873527554730">Не ўдаецца знайсці змесціва на старонцы</translation>
<translation id="6219250889396046657">Каб выкарыстоўваць і захоўваць даныя AIWIZE ва ўліковым запісе <ph name="USER_EMAIL"/>, увядзіце фразу-пароль</translation>
<translation id="8221491193165283816">Звычайна вы блакіруеце апавяшчэнні. Каб даць дазвол гэтаму сайту на паказ апавяшчэнняў, націсніце тут.</translation>
<translation id="8377926237617998195">Каб выкарыстоўваць камеру, дайце AIWIZE адпаведны доступ у <ph name="BEGIN_LINK"/>сістэмных наладах<ph name="END_LINK"/></translation>
<translation id="1755067029031059271">AIWIZE не можа праверыць паходжанне гэтага пашырэння. Яно можа быць небяспечным. Выдаліце яго з AIWIZE, каб яно больш не магло бачыць і змяняць даныя на сайтах, якія вы наведваеце, уключаючы асабістую інфармацыю.</translation>
<translation id="8207657266087451193">Калі відарыс не мае прыдатнага апісання, AIWIZE паспрабуе дадаць яго для вас. Каб стварыць апісанні, відарысы адпраўляюцца ў AIWIZE. Гэты параметр можна адключыць у наладах у любы час.</translation>
<translation id="7792526144795244436">Увайсці ў AIWIZE праз новы профіль?</translation>
<translation id="976541154724186511"><ph name="BEGIN_LINK"/>AIWIZE папярэджвае<ph name="END_LINK"/> пра небяспечныя сайты і спампоўкі</translation>
<translation id="8060549744348950090">Вы даўно не наведвалі сайт. Браўзер AIWIZE адклікаў наступны дазвол: <ph name="PERMISSION"/>.</translation>
<translation id="8313851650939857356">Памылка запуску: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="6098476632210317894">Ваша арганізацыя закрывае AIWIZE, калі ім не карысталіся на працягу <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">Захаваць як відарыс</translation>
<translation id="3360368475735266712">Увайдзіце ў AIWIZE, каб сінхранізаваць і персаналізаваць яго на сваіх прыладах</translation>
<translation id="2591326305549412656">Карыстальнік <ph name="USER_EMAIL_ADDRESS"/> раней выкарыстоўваў AIWIZE</translation>
<translation id="5592122595094519401">Каб працягнуць выкарыстанне даных AIWIZE ва Уліковым запісе AIWIZE <ph name="ACCOUNT_EMAIL"/>, абнавіце AIWIZE</translation>
<translation id="2569754604093464025">Каб і далей атрымліваць абнаўленні AIWIZE, усталюйце Windows 10 ці пазнейшую версію. На гэтым камп’ютары выкарыстоўваецца Windows 8.</translation>
<translation id="8362914115861174987">Мова перакладу:</translation>
<translation id="7296197595428914424">Каб выкарыстоўваць свае паролі і іншыя даныя на ўсіх сваіх прыладах, увайдзіце ў AIWIZE. Пасля ўваходу пароль будзе захаваны ва Уліковым запісе AIWIZE.</translation>
<translation id="9098234372282930719">Потым трэба будзе перазапусціць AIWIZE.</translation>
<translation id="1327729221471951979">AIWIZE рэкамендуе выдаліць яго. <ph name="BEGIN_LINK"/>Даведацца больш пра пашырэнні, якія падтрымліваюцца<ph name="END_LINK"/></translation>
<translation id="8577108764439626300">Публікацыя гэтага пашырэння была адроблена распрацоўшчыкам, яно можа быць небяспечным. Выдаліце яго з AIWIZE, каб яно больш не магло бачыць і змяняць даныя на сайтах, якія вы наведваеце, уключаючы вашу асабістую інфармацыю.</translation>
<translation id="4234753748520037091">AIWIZE патрабуе спраўджання вашай асобы, перш чым вы зможаце захоўваць асобныя даныя ў сваім Уліковым запісе AIWIZE для выкарыстання на ўсіх сваіх прыладах. Калі вы выйдзеце зараз, гэтыя даныя будуць выдалены.</translation>
<translation id="5337999052834672687">{0,plural, =1{Перазапусціце AIWIZE на працягу дня}one{Перазапусціце AIWIZE на працягу # дня}few{Перазапусціце AIWIZE на працягу # дзён}many{Перазапусціце AIWIZE на працягу # дзён}other{Перазапусціце AIWIZE на працягу # дня}}</translation>
<translation id="8438543370129609977">Калі вы выкарыстоўваеце пошук відарысаў, загаловак старонкі, URL-адрас і змесціва, у тым ліку файлы PDF, адпраўляюцца на сервер. <ph name="LEARN_MORE"/></translation>
<translation id="6914496861676471566">Архіў усталёўшчыка пашкоджаны або мае няправільны фармат. Спампуйце AIWIZE зноў.</translation>
<translation id="4378573854226202617">Для браўзера AIWIZE патрабуецца Windows 10 або навейшая версія.</translation>
<translation id="6431861494713261006">Дапамагаць паляпшаць функцыі і прадукцыйнасць Chrome OS шляхам аўтаматычнай адпраўкі ў AIWIZE даных пра выкарыстанне і дыягностыку (неабавязкова).</translation>
<translation id="8691137711639873980">Каб выкарыстоўваць і захоўваць даныя AIWIZE ва Уліковым запісе AIWIZE, пацвердзіце сваю асобу</translation>
<translation id="2097604701283463988">AIWIZE састарэў</translation>
<translation id="871233388178581868">AIWIZE можа правяраць толькі захаваныя паролі</translation>
<translation id="8555465886620020932">Памылка службы: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">Для зручнага доступу можна замацаваць пошук відарысаў: націсніце кнопку "Замацаваць" уверсе бакавой панэлі</translation>
<translation id="856656450041460113">Пошук у спісе моў</translation>
<translation id="227028348235968071">AIWIZE зможа праверыць паролі толькі пасля таго, як вы ўвойдзеце ва Уліковы запіс AIWIZE</translation>
<translation id="839677568225616901">Некалькі арганізацый кіруюць браўзерам AIWIZE</translation>
<translation id="8121009781989288430">Аўтарскія правы: стваральнікі AIWIZE, <ph name="YEAR"/>. Усе правы абароненыя.</translation>
<translation id="8601359445272098721">Навінка! Вы можаце перакладаць тэкст і відарысы на экране, націснуўшы кнопку "Перакласці экран"</translation>
<translation id="3052349005266761501">Ідзе запуск AIWIZE...</translation>
<translation id="6283840329609797763">Збой усталявання з-за нявызначанай памылкі. Спампуйце AIWIZE зноў.</translation>
<translation id="5128665650717824082">AIWIZE for Testing нельга зрабіць стандартным браўзерам.</translation>
<translation id="2433912322225810055">Таксама вызначае, якая старонка паказваецца пры запуску AIWIZE або пошуку з амнібокса.</translation>
<translation id="4100716194836114130">Гэта ваш AIWIZE</translation>
<translation id="8712637175834984815">Зразумела</translation>
<translation id="1419543648228375718">Увайсці ў AIWIZE?</translation>
<translation id="8747073452963259673">ніжні левы вугал поля пошуку: <ph name="LEFT"/>% злева, <ph name="BOTTOM"/>% знізу</translation>
<translation id="3562508460098852626">Паролі можна выдаліць толькі па-за AIWIZE</translation>
<translation id="878572486461146056">Адбылася памылка. Адміністратар сеткі прымяніў групавую палітыку, якая не дазваляе выканаць усталяванне. <ph name="INSTALL_ERROR"/></translation>
<translation id="4831743161813926460">AIWIZE запытвае доступ да камеры і мікрафона для гэтага сайта</translation>
<translation id="64216977793816291">Увайсці ў AIWIZE?</translation>
<translation id="8826492472752484139">Націсніце на "Менеджар пароляў"</translation>
<translation id="6933858244219479645">Сістэма Chrome OS</translation>
<translation id="9084132286318231275">На гэтай мове паказваюцца меню, налады, абвесткі і іншыя тэксты ў AIWIZE</translation>
<translation id="8862326446509486874">Для ўсталявання на сістэмным узроўні ў вас няма неабходных правоў. Паспрабуйце запусціць усталёўшчык ад імені адміністратара.</translation>
<translation id="7289323009146924152">Дадаць профіль AIWIZE</translation>
<translation id="6412037018950369131">Калі так, змяніце пароль, захаваны ў AIWIZE, каб ён супадаў з новым.</translation>
<translation id="1150745254876977823">Палітыка вашай арганізацыі патрабуе, каб вы ўвайшлі ў AIWIZE</translation>
<translation id="8285294305439559616">AIWIZE спрабуе паказаць паролі. Каб дазволіць гэта, увядзіце пароль Windows.</translation>
<translation id="6514033039060816211">AIWIZE можа ацэньваць, якія вы маеце інтарэсы, на падставе гісторыі прагляду сайтаў за апошнія некалькі тыдняў. Гэта інфармацыя застаецца на прыладзе.</translation>
<translation id="6389268239133412586">Не ўдаецца абнавіць AIWIZE</translation>
<translation id="7731184591599776500">Лагатып AIWIZE Enterprise</translation>
<translation id="3424657754843264466">Кіраваць профілямі AIWIZE</translation>
<translation id="8848045066928358658">Каб павысіць бяспечнасць AIWIZE, мы выключылі прыведзенае ніжэй пашырэнне. <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> не змяшчае звестак пра гэта пашырэнне, а значыць, яно магло быць дададзена без вашага ведама.</translation>
<translation id="82609232232243542">Увайдзіце ў AIWIZE</translation>
<translation id="7055223246119657449">Браўзер AIWIZE заблакіраваў спампоўку, бо ў гэтым архіве ёсць файлы, якія могуць хаваць шкоднае ПЗ</translation>
<translation id="9049928023195059068">Уваходзіць у AIWIZE пры ўваходзе ў іншыя сэрвісы AIWIZE</translation>
<translation id="4561046754724442504">AIWIZE аўтаматычна закрыты</translation>
<translation id="5173820533850252773">AIWIZE састарэў</translation>
<translation id="310518206836658214">{0,plural, =1{AIWIZE будзе перазапушчаны праз гадзіну}one{AIWIZE будзе перазапушчаны праз # гадзіну}few{AIWIZE будзе перазапушчаны праз # гадзіны}many{AIWIZE будзе перазапушчаны праз # гадзін}other{AIWIZE будзе перазапушчаны праз # гадзіны}}</translation>
<translation id="9106236359747881194">Выберыце тэкст для пошуку</translation>
<translation id="5190991181158966940">Каб атрымліваць наступныя абнаўленні AIWIZE, вам патрэбная версія Windows 10 ці пазнейшая. На гэтым камп’ютары выкарыстоўваецца Windows 8.1.</translation>
<translation id="7863882214613921971">Адкрыць спасылку ў новай &amp;укладцы AIWIZE</translation>
<translation id="911206726377975832">Выдаліць таксама гісторыю праглядаў?</translation>
<translation id="9134482777260927479">Дапаможнікі</translation>
<translation id="9148058034647219655">Выйсці</translation>
<translation id="2444257125841652328">Ваш сістэмны адміністратар наладзіў AIWIZE, каб адкрыць альтэрнатыўны браўзер для доступу да <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7902365066753170041">Перазапусціць, каб абнавіць &amp;AIWIZE</translation>
<translation id="3350544518197210895">AIWIZE (mDNS-In)</translation>
<translation id="49909619875329637">Атрымайце больш магчымасцей, увайшоўшы ў AIWIZE</translation>
<translation id="296137235951584143">Дастасуйце AIWIZE да сваіх мэт</translation>
<translation id="7977787072794666032">Браўзер AIWIZE больш не падтрымліваецца на Windows XP і Windows Vista, таму можа працаваць няправільна</translation>
<translation id="945522503751344254">Адправіць водгук</translation>
<translation id="4484434718272972655">Хто выкарыстоўвае AIWIZE?</translation>
<translation id="7173394303099002355">Засцеражыце браўзер AIWIZE ад небяспек</translation>
<translation id="983803489796659991">Выканаць усталяванне не ўдалося, бо на серверы абнаўленняў адсутнічаюць хэш-даныя для праграмы.</translation>
<translation id="8435446479956716379">Выкарыстоўваць AIWIZE без уліковага запісу</translation>
<translation id="8992261409816268381">Аўтары AIWIZE</translation>
<translation id="989970834842471429">Выберыце тэкст або відарыс для пошуку з дапамогай пошуку відарысаў</translation>
<translation id="3146636448190445245">Каб выкарыстоўваць месцазнаходжанне, дайце AIWIZE адпаведны доступ у <ph name="BEGIN_LINK"/>сістэмных наладах<ph name="END_LINK"/></translation>
<translation id="137466361146087520">Google Chrome (бэта-версія)</translation>
<translation id="7535429826459677826">Google Chrome для распрацоўшчыкаў</translation>
</translationbundle>